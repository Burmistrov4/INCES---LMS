# Plantilla del entorno local de la suite E2E.
#
#   cp .env.e2e.example .env.e2e    # y rellenar
#
# `.env.e2e` está en .gitignore y **no puede** entrar al historial: guarda la
# contraseña de una cuenta de administración en claro. Este archivo, en cambio,
# sí se versiona — no lleva ningún valor real, sólo los nombres y para qué sirve
# cada uno.
#
# Lo carga `playwright.config.ts` al arrancar, y **no pisa** lo que ya venga del
# entorno: una variable exportada en la línea de órdenes gana sobre este archivo,
# y en CI el archivo no existe (las variables llegan de los secretos).

# --- La cuenta con la que se inicia sesión -----------------------------------
# Usa una cuenta de administración **de prueba**, no la real: la suite crea una
# sesión de verdad en `auth.users` y deja trazas en la auditoría de accesos.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# --- La sección cuya planilla se exporta -------------------------------------
# **Es el título de la tarjeta**, tal como lo pinta el panel — no el código de
# período. El título es `materiaNombre ?? nombre`; el `period_code` sólo sale en
# el subtítulo. Medido el 2026-09-25 contra la base real: la sección sembrada
# tiene `name = 'SA'` y `period_code = 'SA26-2'`, y su tarjeta se titula
# `Programación I [SEMILLA]`.
#
# Tiene que tener matriculados: sin nómina la app avisa y no hay nada que
# exportar.
E2E_SECCION=

# --- Dónde está la app ya compilada ------------------------------------------
# Se sirve con `node serve.mjs`. La compilación va aparte (`flutter build web`)
# porque en el sandbox de Windows el CLI de Flutter no arranca.
E2E_BASE_URL=http://127.0.0.1:8090
E2E_WEB_DIR=build/web

# --- El backend ---------------------------------------------------------------
# **Hace falta aunque el inicio de sesión no lo use**: la lista de secciones del
# panel la sirve Fastify, no Supabase. Sin backend no hay tarjetas y sin tarjetas
# no hay botón de exportar.
E2E_BACKEND_URL=http://127.0.0.1:3001

# Poner en 0 si ya lo tienes corriendo en otra terminal; entonces Playwright no
# lo levanta.
# E2E_ARRANCAR_BACKEND=0

# --- Opcionales ---------------------------------------------------------------
# Usar el Chrome del sistema en vez del Chromium que instala Playwright.
# E2E_CANAL=chrome
