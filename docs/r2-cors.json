{
  "rules": [
    {
      "allowed": {
        "origins": [
          "http://localhost:8090",
          "http://127.0.0.1:8090",
          "http://localhost:8080",
          "http://127.0.0.1:8080"
        ],
        "methods": [
          "GET",
          "PUT"
        ],
        "headers": [
          "Content-Type"
        ]
      },
      "maxAgeSeconds": 3600
    }
  ]
}
