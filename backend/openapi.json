    "/api/v1/admin/acceso": {
      "get": {
        "tags": [
          "Administrador Maestro"
        ],
        "summary": "Traza de accesos (logins y fallos de autenticación) con filtros",
        "description": "Lee `auth_logs` para que el administrador audite inicios de sesión, IPs y fallos de autenticación. Soporta filtro por resultado, correo o usuario, y paginación. El filtro y el recorte se aplican en la base de datos; `total` es el número de filas que cumplen el filtro, no las devueltas.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "SUCCESS",
                "FAILED"
              ],
              "description": "Filtra por resultado del intento. Sin él, ambos."
            },
            "required": false,
            "name": "estado",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Filtra por correo exacto (no parcial)."
            },
            "required": false,
            "name": "email",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Filtra por UUID de usuario de auth. Un valor no UUID se rechaza con 400."
            },
            "required": false,
            "name": "userId",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Tamaño de página. Por defecto 25."
            },
            "required": false,
            "name": "limite",
            "in": "query"
          },
          {
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "description": "Filas a saltar antes de esta página. Por defecto 0."
            },
            "required": false,
            "name": "desplazamiento",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Una página de accesos, del más reciente al más antiguo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaAcceso"
                }
              }
            }
          },
          "400": {
            "description": "Petición inválida. El cuerpo o los parámetros no pasan la validación.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CuerpoError"
                }
              }
            }
          },
          "401": {
            "description": "Falta la sesión o el token no es válido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CuerpoError"
                }
              }
            }
          },
          "403": {
            "description": "La sesión es válida pero el rol no alcanza, o la cuenta está inactiva.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CuerpoError"
                }
              }
            }
          },
          "503": {
            "description": "El servicio o la base de datos no están disponibles.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CuerpoError"
                }
              }
            }
          }
        }
      }
    },
