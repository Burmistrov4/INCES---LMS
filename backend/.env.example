# ============================================================================
#  Configuración de la API del INCES LMS
#  Copia este archivo como `.env` y rellena los valores reales.
#  NUNCA subas `.env` al repositorio.
# ============================================================================

# --- Entorno -----------------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Supabase ----------------------------------------------------------------
# Project Settings → API en el panel de Supabase.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# service_role (o `sb_secret_...`): ignora RLS. Sólo se usa para verificar tokens
# y alimentar cachés de configuración. Trátala como una contraseña de
# administrador: NUNCA va al frontend ni a un repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (almacenamiento pesado, módulo M5) ------------------------
# Las cuatro son opcionales EN CONJUNTO. Sin ninguna, el backend arranca y el
# módulo de archivos queda apagado. Con algunas puestas, el arranque falla a
# propósito: una configuración a medias es un error de despliegue, no un modo
# degradado.
#
# Panel de Cloudflare → R2 → Manage API Tokens → Create API Token
# (permiso «Object Read & Write» sobre el bucket).
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Nombre del bucket, no su URL.
R2_BUCKET=
#
# NO hay variable de endpoint. La URL se deriva del CLOUDFLARE_ACCOUNT_ID:
#   https://<account_id>.r2.cloudflarestorage.com
# Si vienes con una R2_ENDPOINT_URL del panel de Cloudflare, es el mismo valor
# ya construido: no la busques en el código, no la lee nadie.

# Caducidades de las URLs prefirmadas, en segundos.
# Subida corta (5 min): es para subir, no para pasear.
R2_PUT_TTL_SEGUNDOS=300
# Descarga más larga (15 min): da tiempo a abrir el archivo.
R2_GET_TTL_SEGUNDOS=900

# --- CORS --------------------------------------------------------------------
# Orígenes permitidos, separados por coma. `*` permite cualquiera
# (sólo aceptable en desarrollo).
#
# REPARTO DE PUERTOS (no los cruces):
#   backend  -> 3000 (PORT, arriba)     la API
#   Flutter  -> 8080 (--web-port)       el navegador
#
# CORS autoriza el origen del NAVEGADOR, es decir el del frontend. Poner aquí el
# puerto del backend no autoriza nada, porque el backend no es un origen de
# navegador.
#
# IMPORTANTE: `flutter run` sin `--web-port` elige un puerto EFÍMERO distinto en
# cada arranque. Si no se fija, este valor queda obsoleto al segundo intento y el
# navegador bloquea las llamadas a la API con un error de CORS. Arranca el
# frontend con un puerto fijo (`--web-port=8080`) y lístalo aquí.
#
# Si el 3000 está ocupado en tu máquina, cambia PORT y ajusta también
# `API_BASE_URL` en `.env.json` (el frontend). Los tres valores deben contar la
# misma historia.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- Cachés ------------------------------------------------------------------
# TTL en milisegundos. `0` desactiva la caché (útil al depurar el cPanel).
MODULE_CACHE_TTL_MS=30000
SETTINGS_CACHE_TTL_MS=30000

# --- Límite de peticiones ----------------------------------------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# --- Token PERSONAL de la Management API de Supabase (sbp_) -------------------
# NO confundir con SUPABASE_SERVICE_ROLE_KEY. Son dos credenciales distintas y
# NO son intercambiables:
#
#   Admin API (auth/v1/admin/*)   -> sirve la service role key. Da 200.
#   Management API (api.supabase.com) -> la service role key da 401.
#                                        Hace falta este token personal.
#
# Se necesita para las tareas que la API REST no cubre porque tocan el esquema
# `auth`, o la configuración del proyecto:
#
#   node supabase/apply-migrations.mjs --check   (aplicar migraciones)
#   node supabase/verificar-esquema.mjs          (30 comprobaciones)
#   node supabase/configurar-smtp.mjs            (SMTP propio)
#   node supabase/personalizar-plantillas.mjs    (plantillas en español)
#   node supabase/eliminar-cuenta.mjs <correo>   (borrar cuentas)
#
# Se obtiene en: supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# --- Correo transaccional (Resend) -------------------------------------------
# Se usa como SMTP propio de Supabase Auth. Sin esto, Supabase usa su proveedor
# por defecto, que impone tres limitaciones a la vez:
#
#   1. Los correos salen de `no-reply@mail.app.supabase.io` -> spam frecuente.
#   2. `rate_limit_email_sent` es 2 por hora.
#   3. Las PLANTILLAS NO SE PUEDEN EDITAR: la API responde HTTP 400.
#      («Email template modification is not available for free tier projects
#       using the default email provider»).
#
# Configuración aplicada con `node supabase/configurar-smtp.mjs --confirmar`.
# Resend expone SMTP en smtp.resend.com:465 con usuario `resend`; la contraseña
# es la propia API key. Se crea en resend.com/api-keys con permiso «Sending
# access» (sólo envío: no permite leer dominios ni otras claves, y eso es
# correcto).
#
# OJO: sin un dominio verificado en Resend, SÓLO se entrega a la dirección dueña
# de la cuenta de Resend. Cualquier otro destinatario se rechaza con 403. Hasta
# verificar un dominio, el flujo de correo sólo se puede probar contra ese
# buzón. Ver ESTADO_DEL_SISTEMA.md.
RESEND_API_KEY=
