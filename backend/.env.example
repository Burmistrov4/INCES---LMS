# ============================================================================
#  Configuración de la API del INCES LMS
#  Copia este archivo como `.env` y rellena los valores reales.
#  NUNCA subas `.env` al repositorio.
# ============================================================================

# --- Entorno -----------------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Supabase ----------------------------------------------------------------
# Project Settings → API en el panel de Supabase.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# service_role (o `sb_secret_...`): ignora RLS. Sólo se usa para verificar tokens
# y alimentar cachés de configuración. Trátala como una contraseña de
# administrador: NUNCA va al frontend ni a un repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (almacenamiento pesado, módulo M5) ------------------------
# Las cuatro son opcionales EN CONJUNTO. Sin ninguna, el backend arranca y el
# módulo de archivos queda apagado. Con algunas puestas, el arranque falla a
# propósito: una configuración a medias es un error de despliegue, no un modo
# degradado.
#
# Panel de Cloudflare → R2 → Manage API Tokens → Create API Token
# (permiso «Object Read & Write» sobre el bucket).
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Nombre del bucket, no su URL.
R2_BUCKET=

# Caducidades de las URLs prefirmadas, en segundos.
# Subida corta (5 min): es para subir, no para pasear.
R2_PUT_TTL_SEGUNDOS=300
# Descarga más larga (15 min): da tiempo a abrir el archivo.
R2_GET_TTL_SEGUNDOS=900

# --- CORS --------------------------------------------------------------------
# Orígenes permitidos, separados por coma. `*` permite cualquiera
# (sólo aceptable en desarrollo).
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Cachés ------------------------------------------------------------------
# TTL en milisegundos. `0` desactiva la caché (útil al depurar el cPanel).
MODULE_CACHE_TTL_MS=30000
SETTINGS_CACHE_TTL_MS=30000

# --- Límite de peticiones ----------------------------------------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
